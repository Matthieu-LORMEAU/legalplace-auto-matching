{
  "name": "takehome-auto-matching",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "db:reset": "tsx scripts/reset.ts",
    "start": "tsx main.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:timezones": "TZ=UTC vitest run && TZ=Europe/Paris vitest run",
    "typecheck": "tsc --noEmit",
    "arch": "depcruise src main.ts db.ts format-report.ts --config .dependency-cruiser.cjs",
    "lint": "biome check",
    "format": "biome check --write",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@swc/core": "^1.16.22",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "dependency-cruiser": "^18.9.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
